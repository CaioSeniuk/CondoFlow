# Django
SECRET_KEY=troque-esta-chave-em-producao
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Banco de dados (Supabase Postgres) — obrigatória, o backend não sobe sem ela
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Storage de arquivos (Supabase Storage, S3-compatible)
# Project Settings > Storage > S3 Connection no painel do Supabase.
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_BUCKET_NAME=condoflow-media
SUPABASE_S3_ENDPOINT_URL=https://[YOUR-PROJECT-REF].supabase.co/storage/v1/s3
SUPABASE_S3_REGION=us-east-1

# CORS (frontend Vite)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
