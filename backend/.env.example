# Servidor
PORT=8000
NODE_ENV=development

# JWT
JWT_ACCESS_SECRET=troque-esta-chave-em-producao
JWT_REFRESH_SECRET=troque-esta-outra-chave-em-producao
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Banco de dados (Supabase Postgres) — obrigatória, o backend não sobe sem ela
# DATABASE_URL: pooler em transaction-mode (pgbouncer), usado pela aplicação em runtime
# DIRECT_URL: pooler em session-mode, usado por prisma db pull / migrate (pgbouncer não suporta)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Storage de arquivos (Supabase Storage, S3-compatible)
# Project Settings > Storage > S3 Connection no painel do Supabase.
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_BUCKET_NAME=condoflow-media
SUPABASE_S3_ENDPOINT_URL=https://[YOUR-PROJECT-REF].supabase.co/storage/v1/s3
SUPABASE_S3_REGION=us-east-1

# CORS (frontend Vite, quando existir)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seed do banco (usado por `npm run prisma:seed`) — senha aplicada aos usuários de exemplo
SEED_PASSWORD=
